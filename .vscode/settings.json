{
  // 저장 시 자동으로 ESLint 수정 적용
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  // 저장 시 자동 포맷팅
  "editor.formatOnSave": true,
  // 기본 포맷터 설정
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // TypeScript/JavaScript 파일에 대한 설정
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  // ESLint 설정
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.useFlatConfig": true
}
